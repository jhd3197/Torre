          "name": "Juan Hilario",
          "hello": "They told me not to go out tonight. I came anyway."
        },
        "Master Weiss": {
          "name": "La Carreta",
          "hello": "Creak… creak… That’s my cart. Your move."
        },
        "Granny Rose": {
          "name": "La Cuentacuentos",
          "hello": "Sit, mijo. A story first… it ends in checkmate."
