{
  "name": "torre-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write \"src/styles/**/*.scss\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "i18next": "^27.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "typescript-eslint-ts": "npm:typescript@~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
